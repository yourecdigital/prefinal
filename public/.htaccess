# Apache / WebHOST1 (ISPmanager) — статический экспорт Next.js (trailingSlash: true)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Включите после активного SSL в ISPmanager (иначе ERR_CONNECTION_RESET):
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www → без www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- короткие URL (generate-short-redirects.mjs) ---
  RewriteRule ^petergof/?$ /zakaz/shashlyk-petergof/ [R=301,L]
  RewriteRule ^lomonosov/?$ /zakaz/shashlyk-lomonosov/ [R=301,L]
  RewriteRule ^strelna/?$ /zakaz/shashlyk-strelna/ [R=301,L]
  # --- /короткие URL ---

  # Next.js RSC: /path/__next.x/foo/__PAGE__.txt → /path/__next.x.foo.__PAGE__.txt
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*/)(__next\.[^/]+)/([^/]+)/__PAGE__\.txt$ $1$2.$3.__PAGE__.txt [L]

  # Существующие файлы и каталоги
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /menu → /menu/
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # Несуществующие URL → кастомная 404 (out/404.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404.html [L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
