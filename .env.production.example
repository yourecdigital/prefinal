# Скопируйте в .env.production (WebHOST1 / свой домен)
SITE_URL=https://gvkusno.ru
NEXT_PUBLIC_SITE_URL=https://gvkusno.ru

# Верификация (коды из Google Search Console и Яндекс Вебмастера)
# GOOGLE_SITE_VERIFICATION=ваш-код-google
# Яндекс HTML-файл: public/yandex_XXXXX.html

# Яндекс.Метрика (опционально)
# NEXT_PUBLIC_YM_ID=12345678

# FTP для автодеплоя (GitHub Actions → secrets)
# WEBHOST1_FTP_HOST=ftp.webhost1.ru
# WEBHOST1_FTP_USER=логин
# WEBHOST1_FTP_PASSWORD=***
# WEBHOST1_FTP_REMOTE_DIR=/www/gvkusno.ru/
